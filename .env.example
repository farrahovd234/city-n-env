# Authorization Key из личного кабинета GigaChat. Нужен для партии.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Lightning

# Порт игры на компьютере.
CITY_N_HTTP_PORT=8000

