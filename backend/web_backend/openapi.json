{
  "openapi": "3.1.0",
  "info": {
    "title": "Дебаты города N",
    "version": "0.2.0",
    "description": "Запуск партии, ход переговоров и прогноз последствий для игры «Город N»."
  },
  "paths": {
    "/api/v1/scenario": {
      "get": {
        "operationId": "getScenario",
        "summary": "Настройки пилотного сценария",
        "responses": {
          "200": {
            "description": "Сценарий",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                },
                "examples": {
                  "default": {
                    "value": {
                      "title": "Ситуация в городе N",
                      "briefing": "После аварии на предприятии холдинга река загрязнена. Пять сторон обсуждают восстановление очистных и безопасную воду для жителей.",
                      "roles": [
                        {
                          "id": "city_administration",
                          "name": "Администрация",
                          "interest": "Обеспечить горожан водой и привлечь финансирование без непосильных расходов."
                        },
                        {
                          "id": "industrial_holding",
                          "name": "Промкомплекс",
                          "interest": "Сохранить работу предприятия и договориться о распределении расходов."
                        },
                        {
                          "id": "regional_government",
                          "name": "Регион",
                          "interest": "Разрешить конфликт и добиться участия холдинга в финансировании."
                        },
                        {
                          "id": "city_residents",
                          "name": "Жители",
                          "interest": "Получить безопасную воду без роста тарифов."
                        },
                        {
                          "id": "environmental_ngo",
                          "name": "Эко-НКО",
                          "interest": "Добиться независимого контроля и открытых данных о состоянии реки."
                        }
                      ],
                      "total_cost_rub": 270000000,
                      "max_bargaining_turns": 15
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/games": {
      "post": {
        "operationId": "startGame",
        "summary": "Запустить партию",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              },
              "examples": {
                "defaults": {
                  "value": {}
                },
                "studentStrategies": {
                  "value": {
                    "strategies": {
                      "city_residents": "Добивайтесь чистой воды и заморозки тарифов."
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Партия поставлена на выполнение",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartResponse"
                },
                "examples": {
                  "queued": {
                    "value": {
                      "game_id": "demo-run-001",
                      "status": "queued",
                      "status_url": "/api/v1/games/demo-run-001"
                    }
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL состояния партии",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Неверная роль или тип стратегии",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid": {
                    "value": {
                      "code": "invalid_game_input",
                      "message": "Проверьте поля стратегий."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
