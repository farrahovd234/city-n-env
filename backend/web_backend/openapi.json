    "/api/v1/games/{game_id}/cancel": {
      "parameters": [
        {
          "name": "game_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "post": {
        "operationId": "cancelGame",
        "summary": "Остановить партию",
        "responses": {
          "200": {
            "description": "Партия отменена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelledGame"
                },
                "examples": {
                  "result": {
                    "value": {
                      "game_id": "demo-run-001",
                      "status": "cancelled",
                      "progress": {
                        "transcript": [],
                        "report_markdown": "Игра отменена."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Запуск не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "result": {
                    "value": {
                      "code": "game_not_found",
                      "message": "Партия не найдена."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Запуск уже завершён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "result": {
                    "value": {
                      "code": "game_cannot_cancel",
                      "message": "Партию уже нельзя отменить."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoleId": {
        "type": "string",
        "enum": [
          "city_administration",
          "industrial_holding",
          "regional_government",
          "city_residents",
          "environmental_ngo"
        ]
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/RoleId"
          },
          "name": {
            "type": "string"
          },
          "interest": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "interest"
        ],
        "additionalProperties": false
      },
      "Scenario": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "briefing": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "minItems": 5,
            "maxItems": 5
          },
          "total_cost_rub": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_bargaining_turns": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "title",
          "briefing",
          "roles",
          "total_cost_rub",
          "max_bargaining_turns"
        ],
        "additionalProperties": false
      },
      "StartRequest": {
        "type": "object",
        "properties": {
          "strategies": {
            "type": "object",
            "properties": {
              "city_administration": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Стратегия роли. Пустое поле форма передаёт как отсутствие свойства."
              },
              "industrial_holding": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Стратегия роли. Пустое поле форма передаёт как отсутствие свойства."
              },
              "regional_government": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Стратегия роли. Пустое поле форма передаёт как отсутствие свойства."
              },
              "city_residents": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Стратегия роли. Пустое поле форма передаёт как отсутствие свойства."
              },
              "environmental_ngo": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Стратегия роли. Пустое поле форма передаёт как отсутствие свойства."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "StartResponse": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "queued"
          },
          "status_url": {
            "type": "string"
          }
        },
        "required": [
          "game_id",
          "status",
          "status_url"
        ],
        "additionalProperties": false
      },
      "PendingGame": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running"
            ]
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          }
        },
        "required": [
          "game_id",
          "status"
        ],
        "additionalProperties": false
      },
      "CompletedGame": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "completed"
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          }
        },
        "required": [
          "game_id",
          "status",
          "result"
        ],
        "additionalProperties": false
      },
      "FailedGame": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "failed"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          }
        },
        "required": [
          "game_id",
          "status",
          "error"
        ],
        "additionalProperties": false
      },
      "Game": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PendingGame"
          },
          {
            "$ref": "#/components/schemas/CompletedGame"
          },
          {
            "$ref": "#/components/schemas/FailedGame"
          },
          {
            "$ref": "#/components/schemas/CancelledGame"
          }
        ]
      },
      "Contribution": {
        "type": "object",
        "properties": {
          "role_id": {
            "$ref": "#/components/schemas/RoleId"
          },
          "pledged_rub": {
            "type": "number",
            "minimum": 0
          },
          "spent_on_conditions_rub": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "role_id",
          "pledged_rub",
          "spent_on_conditions_rub"
        ],
        "additionalProperties": false
      },
      "Condition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner_role_id": {
            "$ref": "#/components/schemas/RoleId"
          },
          "value": {
            "type": [
              "boolean",
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "id",
          "owner_role_id",
          "value"
        ],
        "additionalProperties": false
      },
      "Vote": {
        "type": "object",
        "properties": {
          "role_id": {
            "$ref": "#/components/schemas/RoleId"
          },
          "value": {
            "enum": [
              "for",
              "against",
              "abstain",
