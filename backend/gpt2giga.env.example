# Вставьте Authorization Key из личного кабинета GigaChat.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Lightning

# Ключ прокси должен совпадать с CITY_N_LLM_API_KEY в backend/.env.
GPT2GIGA_MODE=DEV
GPT2GIGA_HOST=127.0.0.1
GPT2GIGA_PORT=8090
GPT2GIGA_ENABLE_API_KEY_AUTH=True
GPT2GIGA_API_KEY=city-n-local
